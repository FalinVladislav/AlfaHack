{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/pages/staff/**/*.ts",
    "src/pages/staff/**/*.tsx",
    "src/components/applications/**/*.ts",
    "src/components/notifications/**/*.tsx",
    "src/components/AlfaLogo.tsx"
  ]
}
